# Copy file này thành .env và điền giá trị thật (.env đã gitignore)

# ── LLM (OpenAI-compatible) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=openai/gpt-4o-mini

# ── OpenRouter (embedding) ───────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Cloud hoặc local (khớp docker-compose.yml)
POSTGRES_URL=postgresql+asyncpg://user:pass@host:5432/dbname
PG_DSN=postgresql://user:pass@host:5432/dbname

# ── Qdrant ───────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vivu_specs

# ── Embedding model (vector ingest) ──────────────────────────────────────
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_DIM=2048

# ── Rerank (Cohere) ─────────────────────────────────────────────────────
RERANK_ENABLED=true
RERANK_MODEL=cohere
RERANK_TOP_K=20
COHERE_API_KEY=

# ── Scope (BDS Trust Foundation) ─────────────────────────────────────────
SCOPE_ENABLED=true
SCOPE_MODELS=VF 6,VF 8
SCOPE_VERSIONS=Eco,Plus

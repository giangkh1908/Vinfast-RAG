# Copy file này thành .env và điền giá trị thật (.env đã gitignore)
# Lấy key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Model (có thể ghi đè, mặc định như dưới)
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini

# DB local (khớp docker-compose.yml)
QDRANT_URL=http://localhost:16333
PG_DSN=postgresql://vivu:vivu@localhost:15432/vivu
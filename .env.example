# Copy file này thành .env và điền giá trị thật (.env đã gitignore)

# ── Chat + Rerank: DeepInfra (OpenAI-compatible) ──────────────────────────
# Lấy key tại https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=
DEEPINFRA_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Model dự phòng khi model chính lỗi (fallback tự động)
DEEPINFRA_FALLBACK_MODEL=anthropic/claude-haiku-4-5
# Reranker được host trên DeepInfra (2025): Qwen/Qwen3-Reranker-0.6B | 4B | 8B,
# nvidia/llama-nemotron-rerank-vl-1b-v2. KHÔNG có jina-reranker.
DEEPINFRA_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# ── Token limits (multi-turn safety) ───────────────────────────────────────
# Cap output: câu trả lời cuối / JSON tool call (token)
LLM_MAX_OUTPUT_TOKENS=4000
LLM_TOOL_CALL_MAX_TOKENS=1024
# Cap 1 message người dùng (query) tối đa (token) — vượt quá sẽ bị TỪ CHỐI (HTTP 400, không cắt ngầm)
LLM_USER_INPUT_MAX_TOKENS=1000
# Cap input: tổng system + history + query gửi lên model (token) — backstop
# cho history tích lũy qua nhiều turn. Context RAG tính riêng (top-k, sau này).
LLM_INPUT_MAX_TOKENS=16000

# ── Embedding: OpenRouter (DeepInfra không host openai/text-embedding-3-small) ──
# Lấy key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# DB cloud (mặc định). Fallback local: xem docker-compose.local.yml
# Qdrant Cloud:
QDRANT_URL=https://<cluster-id>.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=<qdrant-cloud-api-key>
# Neon (Postgres) — nhớ ?sslmode=require:
PG_DSN=postgresql://<user>:<password>@<host>.neon.tech/neondb?sslmode=require

# Redis cache (Upstash) — REST API (ưu tiên, khỏi TCP):
# REDIS_URL=https://<db>.upstash.io  +  REDIS_TOKEN=<rest-token>
# Hoặc TCP (fallback khi không có REDIS_TOKEN): REDIS_URL=rediss://default:<pass>@<db>.upstash.io:6379
# Không set → cache disabled (no-op).
REDIS_URL=https://<db>.upstash.io
REDIS_TOKEN=
CACHE_ENABLED=true
RATE_LIMIT_ENABLED=true
# Rate limiting: 30 requests/phút per IP, burst 5, max 50 concurrent in-flight
RATE_LIMIT_RPM=30
RATE_LIMIT_BURST=5
BACKPRESSURE_MAX=50

# Nếu muốn chạy local (fallback), đổi thành:
# QDRANT_URL=http://localhost:16333
# QDRANT_API_KEY=
# PG_DSN=postgresql://vivu:vivu@localhost:15432/vivu

# ── Admin & Metrics Telemetry ──────────────────────────────────────────────
ADMIN_API_KEY=vivu-admin-secret-key-2026
METRICS_ENABLED=true
USD_VND_EXCHANGE_RATE=25400.0
APP_VERSION=v1.0.0
